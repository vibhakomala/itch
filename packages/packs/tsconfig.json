{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../protocol"
    }
  ]
}
